generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Severity {
  low
  medium
  high
  critical
}

enum Status {
  open
  in_progress
  resolved
  closed
}

/// Application roles for RBAC.
/// - user: default; report bugs, comment, vote
/// - admin: triage bugs (status / severity / assignee)
/// - super_admin: all admin powers + manage user roles
enum Role {
  user
  admin
  super_admin
}

enum ActivityType {
  created
  status_changed
  severity_changed
  assignee_changed
  commented
  edited
  boosted
  unboosted
  deleted
  restored
  comment_deleted
  type_changed
  category_changed
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  /// Null for Google-only accounts; required for credentials login/signup.
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  role          Role          @default(user)
  /// Email when mentioned, assigned, or when an issue you reported changes status (#151).
  emailNotifications Boolean  @default(true)
  /// Bumped on password reset; JWTs carrying an older value are rejected (#208).
  sessionVersion Int          @default(0)
  createdAt     DateTime      @default(now())
  reportedBugs  Bug[]         @relation("BugReporter")
  assignedBugs  Bug[]         @relation("BugAssignee")
  comments            Comment[]
  votes               Vote[]
  activities          BugActivity[]
  passwordResetTokens PasswordResetToken[]
  watches             IssueWatch[]
  notifications       Notification[]
}

/// Single-use password reset tokens (~30 min TTL). Store only the SHA-256 hash.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IssueType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bugs        Bug[]
}

model Bug {
  id          String        @id @default(cuid())
  title       String
  description String
  severity    Severity      @default(medium)
  status      Status        @default(open)
  typeId      String?
  type        IssueType?    @relation(fields: [typeId], references: [id], onDelete: SetNull)
  voteCount   Int           @default(0)
  isBoosted   Boolean       @default(false)
  boostedAt   DateTime?
  isDeleted   Boolean       @default(false)
  deletedAt   DateTime?
  proofLinks  String[]      @default([])
  reporterId  String
  assigneeId  String?
  categoryId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  reporter    User          @relation("BugReporter", fields: [reporterId], references: [id])
  assignee    User?         @relation("BugAssignee", fields: [assigneeId], references: [id])
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  comments    Comment[]
  votes       Vote[]
  watches       IssueWatch[]
  notifications Notification[]
  activities  BugActivity[]

  @@index([categoryId])
  @@index([typeId])
  @@index([isBoosted])
  @@index([isDeleted])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bugs      Bug[]
}

model BugActivity {
  id        String       @id @default(cuid())
  bugId     String
  actorId   String
  type      ActivityType
  summary   String
  metadata  Json?
  createdAt DateTime     @default(now())
  bug       Bug          @relation(fields: [bugId], references: [id], onDelete: Cascade)
  actor     User         @relation(fields: [actorId], references: [id])

  @@index([bugId, createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  bugId     String
  authorId  String
  parentId  String?
  body      String
  createdAt DateTime  @default(now())
  /// Set when the author edits the comment; shown as "edited".
  editedAt  DateTime?
  /// Soft delete: the body is cleared and replies keep their place.
  deletedAt DateTime?
  bug       Bug       @relation(fields: [bugId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([bugId])
  @@index([parentId])
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  bugId     String
  value     Int      @default(1)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@unique([userId, bugId])
  @@index([bugId])
}

/// Who follows an issue (#216). People are watching by default when they
/// report, are assigned to or comment on an issue; `watching = false` records
/// an explicit "Unwatch" so they aren't added back automatically.
model IssueWatch {
  userId    String
  bugId     String
  watching  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@id([userId, bugId])
  @@index([bugId])
}

/// In-app notification feed (#216): one row per person per event, written
/// whether or not email is configured or wanted.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  bugId     String?
  /// Event kind, e.g. "comment_added", "mentioned", "status_changed".
  kind      String
  title     String
  /// App-relative link, e.g. /bugs/<id>#comment-<id>.
  url       String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bug       Bug?      @relation(fields: [bugId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}
